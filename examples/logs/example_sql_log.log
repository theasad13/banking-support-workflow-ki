-- TICKET-1001 step 2: installments due on the EOD date with a negative interest amount.
SELECT i.loan_id, l.product_code, l.branch_code, i.inst_no, i.due_date,
       i.opening_principal, i.interest_amount
FROM installments i
JOIN loans l ON l.loan_id = i.loan_id
WHERE i.due_date = '2026-09-30' AND i.interest_amount < 0
ORDER BY i.loan_id;

=== 2026-10-28 16:16:28 | user=analyst | db=sample/bank_lms.db
file=examples/TICKET-1001/queries/03_expected_vs_stored.sql
purpose=TICKET-1001: 03_expected_vs_stored
result=OK: 3 rows
---
-- TICKET-1001 step 3: compare the stored interest with (a) interest at the new rate
-- and (b) the rate-change delta, using the old and new rate from the settings audit.
WITH rate_change AS (
    SELECT product_code, CAST(old_value AS REAL) AS old_rate, CAST(new_value AS REAL) AS new_rate
    FROM settings_audit
    WHERE setting_name = 'BASE_RATE' AND changed_at >= '2026-09-01'
)
SELECT i.loan_id, i.inst_no, i.interest_amount AS stored,
       ROUND(i.opening_principal * rc.new_rate / 1200, 2) AS expected_at_new_rate,
       ROUND(i.opening_principal * (rc.new_rate - rc.old_rate) / 1200, 2) AS rate_change_delta,
       CASE WHEN ABS(i.interest_amount - i.opening_principal * (rc.new_rate - rc.old_rate) / 1200) < 0.01
            THEN 'stored = delta' ELSE 'other' END AS finding
FROM installments i
JOIN loans l ON l.loan_id = i.loan_id
JOIN rate_change rc ON rc.product_code = l.product_code
WHERE i.due_date >= '2026-09-01' AND i.due_date <= '2026-09-30'
ORDER BY i.loan_id;

=== 2026-10-28 16:16:28 | user=analyst | db=sample/bank_lms.db
file=examples/TICKET-1001/queries/04_config_check.sql
purpose=TICKET-1001: 04_config_check
result=OK: 3 rows
---
-- TICKET-1001 step 4: rule out configuration. Is the rate change approved, and do the
-- product's GL mappings point to GL accounts that exist?
SELECT 'audit' AS check_type, product_code, setting_name AS item,
       old_value || ' -> ' || new_value AS detail,
       CASE WHEN approved_by IS NOT NULL THEN 'approved by ' || approved_by ELSE 'NOT APPROVED' END AS result
FROM settings_audit
WHERE product_code = 'HL-VAR'
UNION ALL
SELECT 'gl_mapping', s.product_code, s.setting_name, s.setting_value,
       CASE WHEN g.gl_code IS NOT NULL THEN 'GL exists' ELSE 'GL MISSING' END
FROM product_settings s
LEFT JOIN gl_accounts g ON g.gl_code = s.setting_value
WHERE s.product_code = 'HL-VAR' AND s.setting_name LIKE '%_GL';

